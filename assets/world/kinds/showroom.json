    {
      "id": "showroom-coin",
      "about": "A big credit coin floating over the pedestal: it turns, bobs and shines on the shared clock. Tap it and it flips over with a hop.",
      "parts": {
        "model": {"file": "credit_coin.glb", "material": "brass"},
        "touchSound": {"effect": "bell", "gain": 0.5}
      },
      "loops": {
        "show": {
          "period": 6,
          "pieces": [
            {"ch": "turn.y", "shape": "spin", "amp": 1},
            {"ch": "move.y", "shape": "wave", "amp": 0.06},
            {"ch": "glow", "shape": "wave", "amp": 0.3}
          ]
        },
        "flip": {
          "period": 1.2,
          "restart": true,
          "blend": 0.1,
          "pieces": [
            {"ch": "turn.x", "shape": "spin", "amp": 2},
            {"ch": "move.y", "shape": "keys", "keys": [[0, 0], [0.5, 0.25], [1, 0]]},
            {"ch": "glow", "shape": "beat", "amp": 1.5, "decay": 3}
          ]
        }
      },
      "states": {
        "idle": {"loop": "show", "on": {"tap": "flipped"}},
        "flipped": {"loop": "flip", "afterLoops": 1, "next": "idle"}
      },
      "start": "idle"
    },
    {
      "id": "showroom-spark",
      "about": "A small glowing spark circling the coin: around, in and out, up and down, each at its own pace.",
      "parts": {"glowbox": {"size": 0.025, "color": [1, 0.8, 0.4], "glow": 4}},
      "loops": {
        "circle": {
          "period": 7,
          "pieces": [
            {"ch": "move", "shape": "orbit", "amp": [0.75, 0.3, 0]},
            {"ch": "glow", "shape": "noise", "amp": 0.4, "rate": 2}
          ]
        }
      },
      "states": {"fly": {"loop": "circle"}},
      "start": "fly"
    },
