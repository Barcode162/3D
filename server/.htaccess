# The room files are private (relay.php reads them directly).
RedirectMatch 403 ^.*/rooms/
# Accounts (passwords as hashes, tokens, profiles) are private too;
# account.php serves what may be public.
RedirectMatch 403 ^.*/accounts/
# The bar opens straight into its loading screen (user, 2026-10-21): no
# sign-in page in front; you sign in inside the game. gate.php stays for the
# People screen (gate.php?people) and could guard the bar again by adding:
#   RewriteEngine On
#   RewriteRule ^(account|report|relay|gate)\.php$ - [L]
#   RewriteRule ^version\.txt$ - [L]
#   RewriteRule ^ gate.php [L,QSA]
