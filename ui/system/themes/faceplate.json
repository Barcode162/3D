{
  "format": 1,
  "id": "faceplate",
  "name": "Faceplate",
  "about": "The drum machine: glossy keys, keycap lights.",
  "scheme": "dark",
  "click": [
    2600,
    0.025,
    "square"
  ],
  "tokens": {
    "bg": "#0A0908",
    "bg-glow": "radial-gradient(ellipse 90% 50% at 50% -8%, rgba(242,140,44,.13), transparent 70%)",
    "text": "#EEE8DC",
    "text-2": "#A59E92",
    "text-3": "#6B655D",
    "rule": "#2C2926",
    "panel": "linear-gradient(180deg, #1C1A18, #131210)",
    "panel-bw": "0px",
    "panel-r": "16px",
    "panel-blur": "none",
    "panel-edge": "inset 0 1px 0 rgba(255,255,255,.07), 0 0 0 1px #2C2926, 0 14px 34px rgba(0,0,0,.55)",
    "over": "rgba(22,20,18,.86)",
    "field": "#0D0C0B",
    "field-edge": "inset 0 2px 4px rgba(0,0,0,.7), inset 0 0 0 1px #24211E",
    "field-r": "8px",
    "key-bg": "linear-gradient(180deg, #3B3733 0%, #2A2724 55%, #22201D 100%)",
    "key-bw": "0px",
    "key-r": "8px",
    "key-text": "#EEE8DC",
    "key-travel": "3px",
    "key-shadow": "inset 0 1px 0 rgba(255,255,255,.17), 0 3px 0 #0A0908, 0 5px 10px rgba(0,0,0,.6)",
    "key-shadow-down": "inset 0 1px 0 rgba(255,255,255,.08), 0 0 0 #0A0908, 0 1px 3px rgba(0,0,0,.6)",
    "key-gloss": "linear-gradient(180deg, rgba(255,255,255,.15), rgba(255,255,255,0) 52%)",
    "go-bg": "linear-gradient(180deg, #FFAE5C 0%, #F28C2C 50%, #D46B10 100%)",
    "go-text": "#1C0E06",
    "go-glow": "0 0 20px rgba(242,140,44,.45)",
    "accent": "#F28C2C",
    "c1": "#EF4B33",
    "c2": "#F28C2C",
    "c3": "#F2C744",
    "c4": "#EDE7D9",
    "off": "#2A2724",
    "led": "#FF4A3D",
    "ok": "#56CF86",
    "warn": "#F2C744",
    "bad": "#FF6A64",
    "display": "\"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "display-w": "800",
    "display-s": "125%",
    "display-ls": "-.02em",
    "text-font": "\"Archivo\", -apple-system, \"Helvetica Neue\", Arial, sans-serif",
    "key-case": "uppercase",
    "key-size": "12px",
    "key-weight": "700",
    "key-ls": ".1em",
    "key-stretch": "75%",
    "knob": "radial-gradient(circle at 50% 35%, rgba(255,255,255,.18), transparent 55%), repeating-conic-gradient(#2E2B28 0 6deg, #1C1A18 6deg 12deg)",
    "step-shape": "key",
    "bg-size": "auto",
    "bg-motion": "none",
    "title-fill": "none",
    "title-ink": "currentColor",
    "title-glow": "transparent",
    "title-motion": "none",
    "title-speed": "6s"
  }
